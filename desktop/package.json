{
  "name": "huddle-desktop",
  "productName": "Huddle",
  "version": "1.9.1",
  "private": true,
  "description": "Huddle desktop app",
  "author": "Huddle",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "app.huddle.desktop",
    "productName": "Huddle",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "build/tray.png",
      "build/tray-unread.png",
      "build/icon.png",
      "app.config.json",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Huddle",
      "deleteAppDataOnUninstall": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "installerHeader": "build/installerHeader.bmp",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/uninstallerSidebar.bmp"
    },
    "artifactName": "Huddle-${version}-${os}-${arch}.${ext}",
    "publish": [
      {
        "provider": "generic",
        "url": "https://huddle.invalid/desktop-updates"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "socket.io-client": "^4.8.4"
  },
  "homepage": "https://github.com/PixeledGameDev/Huddle"
}
