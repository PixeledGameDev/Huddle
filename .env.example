# Local development
DATABASE_URL=postgres://postgres:postgres@localhost:5432/huddle
PORT=3000
# Set to "true" only when connecting to Render Postgres from outside Render
DATABASE_SSL=false

# Optional: enables the GIF picker (free key from developers.giphy.com)
GIPHY_API_KEY=
# Optional: per-server file storage cap in MB (default 250)
SERVER_STORAGE_MB=250

# Optional: store uploaded files in Cloudflare R2 instead of Postgres (all four are required)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Optional: folder holding the desktop installers when R2 isn't used (local development). With R2, the GitHub workflow uploads them.
DOWNLOADS_DIR=

# Optional: email, for password resets and security notices. Uses Resend (resend.com); the sender domain must be verified there.
RESEND_API_KEY=
MAIL_FROM="Huddle <no-reply@yourdomain.com>"
# Optional but recommended: a long random string that encrypts two-factor secrets in the database. Don't change it later.
AUTH_SECRET=

# Optional: secret used to sign link-preview image URLs. If unset, a random one is made on each start (previews still work).
EMBED_SECRET=

# Optional: extra usernames that always have Huddle Admin (comma-separated). Applied at startup if the account exists.
HUDDLE_ADMIN_USERNAMES=
