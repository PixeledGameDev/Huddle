# Local development
DATABASE_URL=postgres://postgres:postgres@localhost:5432/huddle
PORT=3000
# Set to "true" only when connecting to Render Postgres from outside Render
DATABASE_SSL=false

# Optional: enables the GIF picker (free key from developers.giphy.com)
GIPHY_API_KEY=
# Optional: per-server file storage cap in MB (default 250)
SERVER_STORAGE_MB=250

# Optional: store uploaded files in Cloudflare R2 instead of Postgres (all four are required)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
